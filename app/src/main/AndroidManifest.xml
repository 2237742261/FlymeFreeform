<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.eta.flymefreeform.permission.REQUEST_ENTRY_CATALOG"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.eta.flymefreeform.permission.REQUEST_ENTRY_CATALOG" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.coloros.smartsidebar" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FlymeFreeformApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlymeFreeform">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 面板里拖动排序的落盘请求：system_server 发广播，App 进程即使没运行也会被拉起 -->
        <receiver
            android:name=".ToolOrderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eta.flymefreeform.action.TOOL_ORDER_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
